# MyShop Phase 1 environment template.
# Copy to .env and replace every angle-bracket placeholder before starting a
# non-local environment. This file contains no usable credentials.

# Compose image tags. Leave the local defaults in docker-compose.yml when
# building from source; set these to registry tags when using published images.
API_IMAGE=myshop-api:local
WEB_IMAGE=myshop-web:local
SITE_DOMAIN=<your-store-domain>
ACME_EMAIL=<admin-email-for-certificates>

# PostgreSQL is the db service in docker-compose.yml.
DB_URL=jdbc:postgresql://db:5432/myshop
DB_USERNAME=myshop
DB_PASSWORD=<generate-a-long-random-database-password>

# Required outside local development. Generate at least 64 random characters.
JWT_SECRET=<generate-a-long-random-jwt-secret>
AUTH_COOKIE_SECURE=true

# Optional first-admin bootstrap. The API creates an admin only when all three
# values are set; it never logs or persists the bootstrap plaintext password.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Uploads are persisted by the api service volume.
UPLOAD_PATH=/app/uploads
UPLOAD_URL_PREFIX=/api/uploads

# Delivery email is disabled until SMTP is deliberately configured.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SITE_URL=https://<your-store-domain>

# Optional Cloudflare Turnstile protection.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Only proxy addresses are allowed to supply X-Real-IP/X-Forwarded-For.
# In the bundled Compose topology Caddy is the only public edge; add its
# container address or the exact Docker network gateway when needed.
# The bundled Compose network assigns Caddy the fixed address 172.30.0.2.
# Only exact proxy addresses may supply forwarded client IP headers.
RATE_LIMIT_TRUSTED_PROXIES=127.0.0.1,::1,172.30.0.2

# Host metrics are collected by the internal-only node-exporter sidecar.
# Do not publish its port; override this only with another private endpoint.
NODE_EXPORTER_URL=http://node-exporter:9100

# Host data disk mountpoint shown separately in the admin dashboard.
DATA_DISK_MOUNTPOINT=/data
