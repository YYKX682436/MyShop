# Local/reproducible API image. CI may publish the same artifact with Jib.
FROM maven:3.9.11-eclipse-temurin-25 AS build
WORKDIR /build
COPY apps/api/pom.xml apps/api/pom.xml
RUN mvn -B -f apps/api/pom.xml dependency:go-offline
COPY apps/api/src apps/api/src
RUN mvn -B -f apps/api/pom.xml package

# Keep the runtime distribution explicit: this image uses Ubuntu Noble, so
# user creation below uses Debian/Ubuntu's documented adduser/addgroup flags.
FROM eclipse-temurin:25-jre-noble
WORKDIR /app
RUN apt-get update \
 && apt-get install --no-install-recommends --yes wget \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 10001 myshop \
 && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin myshop
COPY --from=build /build/apps/api/target/myshop-api-*.jar /app/app.jar
COPY apps/api/src/main/resources/db/production-schema-contract.json /app/production-schema-contract.json
RUN mkdir -p /app/uploads /app/private-uploads && chown -R 10001:10001 /app
USER 10001:10001
EXPOSE 8083
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
