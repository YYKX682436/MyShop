# Runtime-only image. The Web CI job installs dependencies, runs checks and
# Next.js build once, then stages the standalone output, static assets and public files.
# CI installs the standalone runtime on Linux/glibc. Keep the runtime ABI
# compatible with that native Sharp binary so Next image optimization works.
FROM node:22-bookworm-slim

ARG SOURCE_SHA
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME="0.0.0.0"

RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 nextjs

COPY --chown=nextjs:nodejs node_modules/ ./node_modules/
COPY --chown=nextjs:nodejs apps/web/node_modules/ ./apps/web/node_modules/
COPY --chown=nextjs:nodejs apps/web/package.json apps/web/server.js ./apps/web/
COPY --chown=nextjs:nodejs apps/web/.next/BUILD_ID \
     apps/web/.next/app-path-routes-manifest.json \
     apps/web/.next/build-manifest.json \
     apps/web/.next/package.json \
     apps/web/.next/prerender-manifest.json \
     apps/web/.next/required-server-files.json \
     apps/web/.next/routes-manifest.json ./apps/web/.next/
COPY --chown=nextjs:nodejs apps/web/.next/server/ ./apps/web/.next/server/
COPY --chown=nextjs:nodejs apps/web/.next/static/ ./apps/web/.next/static/
COPY --chown=nextjs:nodejs apps/web/public/ ./apps/web/public/
LABEL org.opencontainers.image.revision="$SOURCE_SHA"

USER nextjs
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
