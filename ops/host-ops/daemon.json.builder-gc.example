{
  "data-root": "/data/docker",
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "10m",
    "max-file": "3"
  },
  "builder": {
    "gc": {
      "enabled": true,
      "defaultKeepStorage": "2GB",
      "policy": [
        {
          "keepStorage": "2GB",
          "filter": ["unused-for=168h"]
        },
        {
          "keepStorage": "3GB",
          "filter": ["unused-for=24h"]
        },
        {
          "keepStorage": "4GB"
        }
      ]
    }
  }
}
