# Copy to /etc/myshop-friend/myshop.env, set root:root 0600, and replace the
# blank values after the shared-host audit. Never commit the real environment.
MYSHOP_COMPOSE_PROJECT_NAME=myshop-friend-prod
MYSHOP_COMPOSE_FILE=/opt/myshop-friend/runtime/docker-compose.shared-server.yml
MYSHOP_RUNTIME_ROOT=/opt/myshop-friend/runtime
MYSHOP_RELEASE_MANIFEST_FILE=/opt/myshop-friend/runtime/release-manifest.json
MYSHOP_SHARED_SERVER=1
MYSHOP_DATA_ROOT=/srv/myshop-friend
MYSHOP_DATA_MOUNTPOINT=/
# Baota marks 8082 unused; the target-host preflight must still pass.
MYSHOP_WEB_PORT=8082
MYSHOP_EDGE_SUBNET=
MYSHOP_CADDY_IP=
# Set only after observing the source address Caddy receives from Baota Nginx.
# Use a single-host prefix: IPv4 /32 or IPv6 /128. Preflight blocks startup if blank.
MYSHOP_BAOTA_NGINX_PROXY_CIDR=
MYSHOP_BAOTA_PROXY_SOURCE_CONFIRMED=0

# Set to 1 only after import-offline-image-bundle.sh verified all five images.
# The bundle records the full source digests and the loaded linux/amd64 config IDs.
MYSHOP_OFFLINE_IMAGES=0
MYSHOP_OFFLINE_IMAGE_BUNDLE_FILE=/opt/myshop-friend/runtime/offline-image-bundle.json
# Offline imports use the digest-derived tags without @sha256 so Docker can
# resolve the already-loaded image. Normal registry deployments leave these blank.
MYSHOP_POSTGRES_IMAGE=
MYSHOP_CADDY_IMAGE=
MYSHOP_NODE_EXPORTER_IMAGE=

# Set both image refs to the same full SHA from the validated release manifest.
MYSHOP_API_IMAGE=
MYSHOP_WEB_IMAGE=

DB_USERNAME=myshop
DB_PASSWORD=
JWT_SECRET=
AUTH_COOKIE_SECURE=true
PUBLIC_SITE_URL=https://myshop-candidate.mc520.top
MAIL_SITE_URL=https://myshop-candidate.mc520.top
MAIL_ENABLED=false

# Per-deploy backup only; no timer or host-wide Docker maintenance is installed.
MYSHOP_BACKUP_DIR=/srv/myshop-friend/backups/database
MYSHOP_STORAGE_MOUNTPOINT=/srv/myshop-friend
MYSHOP_RUN_HOST_MAINTENANCE=0
